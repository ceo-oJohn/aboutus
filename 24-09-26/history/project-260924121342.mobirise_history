\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#bed3f9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                <b>Serviços</b></h3>\n            <h4 mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" class=\"mbr-section-subtitle mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-5\">\n                Subtitle\n            </h4>\n        </div>\n        <div class=\"row mt-4\">\n            <div class=\"card col-12\">\n                <div class=\"card-wrapper\">\n                    <div class=\"top-line row\" mbr-if=\"showTitleCard\">\n                        <div class=\"col\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Mentoria</b></h4>\n                        </div>\n                        <div class=\"col-auto\">\n                            <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price\"></p>\n                        </div>\n                    </div>\n                    <div class=\"bottom-line\">\n                        <p class=\"mbr-text mbr-fonts-style \" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            Nossos clientes neste serviço, buscam um apoio profissional e pontual que possa avaliar o universo de seus negócios e o rumo tecnológico a seguir. <br><br><i><b>\"Ter alguém que conheça o nosso negócio e que traduza para o mundo de tecnologia é essencial e faz a diferença para que possamos focar na empresa e não termos que parar sempre e explicar o que fazemos para cada prestador de serviços ou fornecedores de tecnologia. O mentor, por ter experiência em vários projetos e liberdade de atuação, é o nosso parceiro e porto seguro para navegarmos neste mundo digital.\"</b></i>&nbsp; |&nbsp;Um cliente<br><br><i><b>$ Pacotes a partir de 10hs de mentoria.</b></i></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12\" mbr-if=\"cardsAmount>1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"top-line row\" mbr-if=\"showTitleCard\">\n                        <div class=\"col\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Desenvolvimento NoCode</b></h4>\n                        </div>\n                        <div class=\"col-auto\">\n                            <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price\"></p>\n                        </div>\n                    </div>\n                    <div class=\"bottom-line\">\n                        <p class=\"mbr-text mbr-fonts-style \" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Sabe aquela demanda que você tem para atender um processo pontual do seu negócio? <br><br>Aqueles que muitas vezes se utilizam planilhas que foram feitas por pessoas que nem mais trabalham na sua empresa, e/ou consultas desordenadas em IAs que não foram documentadas e avaliadas corretamente?<br><br>E o sentimento que fica é não justifica ter um desenvolvimento demorado, com custos elevados e o tempo da sua equipe (que já é&nbsp; enxuta) em especificações e acompanhamentos destes projetos?<br><br>Pensando bem, há tem também quando um cliente seu solicita em contrato, um controle adicional, algum dashboard de gerenciamento, relatórios específicos. E normalmente, novas planilhas são criadas etc. Muito provavelmente, você já passou por esta situação, não é<br><br>Este é um cenário típico para um desenvolvimento ágil com ferramentas de NoCode (sem códigos de programação), se encaixam perfeitamente.<br><br>Nossa metodologia simplificada possuem 3 passos apenas:&nbsp;<br><br><b>[1] PREPARAÇÃO:</b> <br>Avaliação da necessidade, e utilização de IA para estruturar o processo.<br><b>[2] PRODUÇÃO: </b><br>Construção do aplicativo, carga de dados necessários e um breve treinamento em vídeo.<br><b>[3] PRONTO: </b><br>Em questão de poucos dias sua equipe já estará utilizando, menos um problema para eles resolverem, e focam no crescimento da empresa.<br><br><b><i>$ pacotes a partir de 3 dias de desenvolvimento.</i></b></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12\" mbr-if=\"cardsAmount>2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"top-line row\" mbr-if=\"showTitleCard\">\n                        <div class=\"col\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Planejamento de projetos de transformação digital</b></h4>\n                        </div>\n                        <div class=\"col-auto\">\n                            <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price\"></p>\n                        </div>\n                    </div>\n                    <div class=\"bottom-line\">\n                        <p class=\"mbr-text mbr-fonts-style \" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\"><i style=\"font-weight: bold;\">\"Preciso avaliar a implantação de um site portal corporativo para a empresa, que seja adequado ao mercado, com funcionalidades novas para público em geral, clientes e parceiros. E que eleve nosso nível de serviços digitais. E neste sentido, precisamos que pensem por nós.\"</i>&nbsp; |&nbsp;Um cliente<br><br>Para nós cada projeto desta natureza é um novo conceito e patamar para a evolução do nosso cliente e também o nosso aprendizado. Portanto, cada caso é um caso e será tratado especificamente, na medida solicitada.<br><br><i><b>$ pacotes a partir de 40hs de projeto.</b></i></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12\" mbr-if=\"cardsAmount>3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"top-line row\" mbr-if=\"showTitleCard\">\n                        <div class=\"col\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Special Issue</b></h4>\n                        </div>\n                        <div class=\"col-auto\">\n                            <p class=\"price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price\">\n                                $39</p>\n                        </div>\n                    </div>\n                    <div class=\"bottom-line\">\n                        <p class=\"mbr-text mbr-fonts-style \" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            Themes in the Mobirise website builder offer multiple blocks: intros, sliders, galleries,\n                            forms, articles, and so on. Start a project and click on the red plus buttons to see the\n                 